rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Enterprise Security Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'anojkumaryadav7290@gmail.com' ||
        request.auth.token.email == 'support.akselling@gmail.com' ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        request.auth.uid == 'admin'
      );
    }

    // Public Product Catalog - Read open; write restricted to verified store owners/admins
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isAuthenticated() && request.auth.token.email == 'anojkumaryadav7290@gmail.com');
    }

    // Dynamic Categories Engine - Read open; management strictly restricted to verified Admin
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage Hero & Marketing Banners - Read open; management strictly restricted to verified Admin
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer & Seller Orders
    // Placement allowed with valid order payload; immutable history; status updates strictly admin
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.items != null && request.resource.data.totalAmount != null;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Payment Transaction Audit Records - Strictly Immutable Ledger
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if false; // IMMUTABLE LEDGER - CANNOT BE ALTERED OR SPOOFED
    }

    // Seller KYC and Sensitive Onboarding Records - Isolated to Owner/Admin
    match /sellers/{sellerId} {
      allow read: if isOwner(sellerId) || isAdmin();
      allow write: if isOwner(sellerId) || isAdmin();
    }

    match /kyc_verifications/{kycId} {
      allow read: if isOwner(kycId) || isAdmin();
      allow write: if isOwner(kycId) || isAdmin();
    }

    // User Profile Documents and Wallet Balances - Strictly User/Admin Isolated
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() || isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Immutable Wallet Transaction Ledger (cashback credits, bonuses, milestone rewards)
    match /wallet_transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false; // STRICTLY IMMUTABLE - ONCE LOGGED, CANNOT BE TAMPERED OR DELETED
    }

    // Customer Withdrawal Requests & Admin Manual Payout Settlement
    match /withdrawal_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin(); // Only verified admin can settle withdrawal requests and generate Parchis
      allow delete: if false;
    }

    // User Carts - Isolated per User
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Price Drop Alerts Subscriptions
    match /PriceAlerts/{alertId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() || isAdmin();
    }

    // Default Zero-Trust Fallback: Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


