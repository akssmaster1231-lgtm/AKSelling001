{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profiles, addresses, and account details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "language": { "type": "string" },
        "notificationEnabled": { "type": "boolean" },
        "addresses": { "type": "array" },
        "savedCards": { "type": "array" },
        "devices": { "type": "array" },
        "walletBalance": { "type": "number" },
        "totalCashbackEarned": { "type": "number" },
        "signupBonusClaimed": { "type": "boolean" },
        "successfulOrdersCount": { "type": "number" },
        "milestoneBonusClaimed": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "products": {
      "title": "Product Catalog",
      "description": "Store products for all categories, full multi-image galleries, pricing, sizes, inventory, and logistics pickup details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "mrp": { "type": "number" },
        "discount": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array", "description": "Array of 4-5 permanent public URLs for multi-photo gallery" },
        "image": { "type": "string" },
        "imageUrl": { "type": "string" },
        "rating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "brand": { "type": "string" },
        "inStock": { "type": "boolean" },
        "stock": { "type": "number", "description": "Total available inventory count" },
        "inventoryCount": { "type": "number" },
        "sizes": { "type": "array", "description": "Available product sizes (e.g. XS, S, M, L, XL, XXL, 3XL, Free Size)" },
        "colors": { "type": "array" },
        "delivery": { "type": "string" },
        "pickupLocation": { "type": "string" },
        "pickupAddress": {
          "type": "object",
          "description": "Fulfillment hub and pickup address tied to product",
          "properties": {
            "businessName": { "type": "string" },
            "street": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "pincode": { "type": "string" },
            "phone": { "type": "string" },
            "sellerGstin": { "type": "string" },
            "logisticsPartner": { "type": "string" },
            "dispatchTimeDays": { "type": "number" }
          }
        },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "tags": { "type": "array" },
        "keywords": { "type": "array" },
        "permanenceLocked": { "type": "boolean", "description": "Flag ensuring lifetime data permanence and zero deletion" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "price", "category"]
    },
    "orders": {
      "title": "Customer Orders",
      "description": "Placed orders and their fulfillment status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryAddress": { "type": "object" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "razorpayOrderId": { "type": "string" },
        "razorpayPaymentId": { "type": "string" },
        "orderStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "totalAmount", "paymentMethod"]
    },
    "banners": {
      "title": "Promotional Banners",
      "description": "Carousels and home banners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "imageUrl"]
    },
    "product_reviews": {
      "title": "Customer Reviews & Photo Ratings",
      "description": "Verified buyer reviews, ratings, and customer-uploaded apparel photos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "photos": { "type": "array" },
        "verifiedPurchase": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "rating", "userName"]
    },
    "fcm_tokens": {
      "title": "Push Notification Tokens",
      "description": "Device tokens for Firebase Cloud Messaging marketing alerts and flash sales",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userEmail": { "type": "string" },
        "platform": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["token"]
    },
    "sellers": {
      "title": "Sellers and Suppliers",
      "description": "Registered sellers, catalog info and verification details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "phone": { "type": "string" },
        "gstin": { "type": "string" }
      },
      "required": ["id"]
    },
    "wallet_transactions": {
      "title": "Wallet Transactions",
      "description": "Ledger of cashback credits, signup bonuses, milestone rewards, and payout withdrawals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "payoutMethod": { "type": "string" },
        "payoutDetails": { "type": "object" },
        "utr": { "type": "string" },
        "orderId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "status", "createdAt"]
    },
    "PriceAlerts": {
      "title": "Price Drop Alerts",
      "description": "User subscriptions to price drop notifications for specific products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "productTitle": { "type": "string" },
        "productImage": { "type": "string" },
        "initialPrice": { "type": "number" },
        "currentPrice": { "type": "number" },
        "targetPrice": { "type": "number" },
        "notifyEmail": { "type": "string" },
        "notifyPush": { "type": "boolean" },
        "notifyEmailPref": { "type": "boolean" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastNotifiedAt": { "type": "string" }
      },
      "required": ["id", "productId", "initialPrice"]
    },
    "notifications": {
      "title": "Catalog & System Notifications",
      "description": "App-wide notification broadcasts when new catalogs and products are uploaded",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "productId": { "type": "string" },
        "productTitle": { "type": "string" },
        "productPrice": { "type": "number" },
        "productImage": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "title", "createdAt"]
    },
    "video_reels": {
      "title": "Video Reels & Shorts",
      "description": "Video shopping reels with sound and linked product purchases",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "videoUrl": { "type": "string" },
        "posterUrl": { "type": "string" },
        "creatorName": { "type": "string" },
        "caption": { "type": "string" },
        "songTitle": { "type": "string" },
        "likesCount": { "type": "number" },
        "tag": { "type": "string" },
        "audioEnabled": { "type": "boolean" },
        "product": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "videoUrl", "caption"]
    },
    "payments_ledger": {
      "title": "Payment & Order Ledger",
      "description": "Incoming transactions for Direct UPI, Card, and Bank payments with customer info, UTR, amount, and screenshots",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "paymentId": { "type": "string" },
        "utrNumber": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentMode": { "type": "string" },
        "status": { "type": "string" },
        "screenshotUrl": { "type": "string" },
        "verifiedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "amount", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "products",
      "description": "Store product catalog items"
    },
    "/banners/{bannerId}": {
      "schema": "banners",
      "description": "Promotional banners and carousel posters"
    },
    "/video_reels/{reelId}": {
      "schema": "video_reels",
      "description": "Video reels and shorts for interactive shopping with sound"
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Customer order fulfillment records"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles and wallet balances"
    },
    "/sellers/{sellerId}": {
      "schema": "sellers",
      "description": "Registered sellers and vendor profiles"
    },
    "/wallet_transactions/{transactionId}": {
      "schema": "wallet_transactions",
      "description": "Wallet cashback, signup bonuses, and rewards"
    },
    "/PriceAlerts/{alertId}": {
      "schema": "PriceAlerts",
      "description": "Price drop alert subscriptions"
    },
    "/notifications/{notificationId}": {
      "schema": "notifications",
      "description": "App-wide new catalog & product broadcast alerts"
    },
    "/payments_ledger/{transactionId}": {
      "schema": "payments_ledger",
      "description": "Real-time payment transactions ledger for merchant audit"
    }
  }
}
